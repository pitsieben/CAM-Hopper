<?xml version="1.0" encoding="utf-8"?>
<!-- CamGh package profile: Release, self-contained win-x64 engine into ..\..\publish\engine.
     After publishing, the CamGhPackage target in CamGh.Engine.csproj builds the Grasshopper project and
     assembles ..\..\publish\package (engine + wwwroot + CamGh.gha). Then run Install-CamGh.bat. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <PublishDir>..\..\publish\engine\</PublishDir>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DeleteExistingFiles>false</DeleteExistingFiles>
  </PropertyGroup>
</Project>
